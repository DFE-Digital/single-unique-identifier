@page "/"
@attribute [Authorize]
@using SUI.UIHarness.Web.Components.Controls
@using SUI.UIHarness.Web.Models

<PageTitle>SUI Test Harness</PageTitle>

<h1>SUI Test Harness</h1>

<div class="" style="padding-top: 24px;">
    <div class="mb-3">
        <p><strong>Current Custodian:</strong> @_displayOrganisationId</p>
    </div>
    
    <ul class="nav nav-tabs mt-3" id="mainTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link @(_currentTab == "enrol" ? "active" : "")" id="tab-enrol-tab" type="button" role="tab" @onclick='_ => ChangeTabs("enrol")'>Get NHS Numbers</button>
        </li>
    </ul>
    <div class="tab-content border border-top-0 p-3" id="mainTabsContent">
        <div class="tab-pane fade show active" id="tab-enrol" role="tabpanel" hidden='@(_currentTab != "enrol")'>
            <EnrolTab SelectedOrgClientId="@_selectedOrgClientId"></EnrolTab>
        </div>
    </div>
    <div class="pt-3 small text-black-50">
        <a href="" class="link-secondary link-underline-opacity-0 link-underline-opacity-100-hover" @onclick:preventDefault @onclick="@(() => _showDebug = !_showDebug)">
            @(_showDebug ? "- Info" : "+ Info")
        </a>
        @if (_showDebug)
        {
           <div class="mt-3">
                <div><strong>Base URL:</strong> @Configuration[ConfigKeys.FindApiBaseUrl]</div>
            </div>
        }
    </div>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;

    private string _selectedOrgClientId = string.Empty;
    private string _displayOrganisationId = string.Empty;
    private string _currentTab = "enrol";
    private bool _showDebug;

    [Inject] public required IConfiguration Configuration { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateTask;
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            _selectedOrgClientId = user.Identity.Name ?? string.Empty;
        }
    }

    private void ChangeTabs(string tab)
    {
        _currentTab = tab;
    }
}